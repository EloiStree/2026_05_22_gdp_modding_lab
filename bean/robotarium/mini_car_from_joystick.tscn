[node name="ModRunTextAsScript" type="Node" parent="." unique_id=238016613 node_paths=PackedStringArray("where_to_create_node")]
script = ExtResource("4_gd7ry")
given_godot_code_to_execute = "extends Node

var car: ModMiniCarFromJoystickCharacter
var timer := 0.0
var move_forward := true

func _ready():
	print(\"Hello World\")

	# Look in parent
	car = get_parent() as ModMiniCarFromJoystickCharacter

	if car == null:
		push_error(\"Parent is not ModMiniCarFromJoystickCharacter\")

func _process(delta: float) -> void:
	if car == null:
		return

	timer += delta

	# Switch every 1 second
	if timer >= 1.0:
		timer = 0.0
		move_forward = !move_forward

	# Forward then left in loop
	if move_forward:
		car.set_joystick(Vector2(0, 1))   # forward
	else:
		car.set_joystick(Vector2(-1, 0))  # left"
where_to_create_node = NodePath("..")
unique_code_file_name = "mini_car_code.gd"
create_node_as_node_3d = true
metadata/_custom_type_script = "uid://ba1fd81r1lqv3"

